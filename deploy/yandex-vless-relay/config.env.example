# =============================================================================
#  Yandex Cloud VLESS+REALITY relay  ->  strongSwan (IKEv2/IPsec)
#  Скопируй в config.env и заполни. Секреты (UUID/ключи/PSK) можно оставить
#  пустыми — install-relay.sh сгенерирует их сам и сохранит в /etc/yandex-relay/state.env
# =============================================================================

# ----- strongSwan сервер (уже существующий, в РФ) ----------------------------
# Публичный IP или DNS-имя твоего strongSwan-сервера (куда relay строит туннель)
STRONGSWAN_SERVER_ADDR="203.0.113.10"
# IKE-идентичность сторон. Любые строки, ДОЛЖНЫ совпадать с тем, что добавишь
# на сервере (см. STRONGSWAN-SERVER.md). Удобно использовать вид user@domain.
RELAY_IKE_ID="relay-yandex@vpn.local"
SERVER_IKE_ID="strongswan@vpn.local"
# Pre-Shared Key для IKEv2. Оставь пустым — сгенерируется. ОБЯЗАН совпасть с сервером.
IPSEC_PSK=""

# ----- XRAY VLESS + REALITY (вход для клиентов) ------------------------------
# Внешний порт входа (REALITY обычно слушает 443)
XRAY_PORT="443"
# Домен-маскировка. ВАЖНО (по твоему требованию): домен из «белых списков» РФ,
# реальный, с TLS 1.3 + HTTP/2, до которого relay из Yandex Cloud имеет доступ.
# Рекомендую Yandex-домен (relay тоже в Yandex Cloud) — dzen.ru / ya.ru, либо vk.com.
# Проверить TLS 1.3 на сервере:  openssl s_client -connect dzen.ru:443 -tls1_3 </dev/null
REALITY_DEST="dzen.ru:443"
REALITY_SERVERNAMES="dzen.ru"
# Секреты VLESS/REALITY — оставь пустыми, сгенерируются автоматически:
VLESS_UUID=""
REALITY_PRIVATE_KEY=""
REALITY_PUBLIC_KEY=""
REALITY_SHORT_ID=""

# ----- Внутренние параметры маршрутизации (менять не обязательно) ------------
# fwmark, которым XRAY помечает трафик юзеров для отправки в IPsec-туннель
FWMARK="42"
# Отдельная таблица маршрутизации для туннеля
ROUTE_TABLE="100"
# MTU/MSS для трафика, уходящего в туннель (учитывает накладные IPsec)
TUNNEL_MSS="1360"
# Имя WAN-интерфейса. auto = определить по default route.
WAN_IF="auto"
