# =============================================================================
#  Yandex Cloud VLESS+REALITY relay  ->  strongSwan (IKEv2/IPsec)
#  Скопируй в config.env и заполни. Секреты VLESS/REALITY (UUID/ключи) можно оставить
#  пустыми — install-relay.sh сгенерирует их сам и сохранит в /etc/yandex-relay/state.env
#  Логин/пароль EAP и CA-сертификат сервера задаёшь руками (их знает твой strongSwan).
# =============================================================================

# ----- strongSwan сервер (уже существующий, в РФ) ----------------------------
# Публичный IP или DNS-имя твоего strongSwan-сервера (куда relay строит туннель)
STRONGSWAN_SERVER_ADDR="203.0.113.10"

# Аутентификация: EAP (логин/пароль) — relay подключается как обычный VPN-юзер.
# Заведи на сервере отдельную учётку для relay (или используй существующую).
EAP_USERNAME="relay-yandex"
EAP_PASSWORD="впиши_пароль_учётки"

# Сервер по EAP всё равно предъявляет СВОЙ сертификат — relay обязан его проверить.
# Файл может содержать НЕСКОЛЬКО сертификатов (корень + промежуточный) — установщик
# разложит их сам. Для Let's Encrypt с leftcert=server-cert.pem (только лист) нужны
# ОБА: ISRG Root X1 + промежуточный R13. На сервере собери их в один файл:
#   cat /etc/ipsec.d/cacerts/isrg-root-x1.pem /etc/ipsec.d/cacerts/letsencrypt-r13.pem > strongswan-ca.pem
# и скопируй на relay.
SERVER_CA_CERT="/root/strongswan-ca.pem"
# Идентичность сервера = значение из SAN его сертификата.
# Для Let's Encrypt это ДОМЕН (не IP). Узнать:
#   openssl x509 -in server-cert.pem -noout -ext subjectAltName
SERVER_ID="vpn.example.com"

# ----- XRAY VLESS + REALITY (вход для клиентов) ------------------------------
# Внешний порт входа (REALITY обычно слушает 443)
XRAY_PORT="443"
# Домен-маскировка. ВАЖНО (по твоему требованию): домен из «белых списков» РФ,
# реальный, с TLS 1.3 + HTTP/2, до которого relay из Yandex Cloud имеет доступ.
# Рекомендую Yandex-домен (relay тоже в Yandex Cloud) — dzen.ru / ya.ru, либо vk.com.
# Проверить TLS 1.3 на сервере:  openssl s_client -connect dzen.ru:443 -tls1_3 </dev/null
REALITY_DEST="dzen.ru:443"
REALITY_SERVERNAMES="dzen.ru"
# Секреты VLESS/REALITY — оставь пустыми, сгенерируются автоматически:
VLESS_UUID=""
REALITY_PRIVATE_KEY=""
REALITY_PUBLIC_KEY=""
REALITY_SHORT_ID=""

# ----- Внутренние параметры маршрутизации (менять не обязательно) ------------
# fwmark, которым XRAY помечает трафик юзеров для отправки в IPsec-туннель
FWMARK="42"
# Отдельная таблица маршрутизации для туннеля
ROUTE_TABLE="100"
# MTU/MSS для трафика, уходящего в туннель (учитывает накладные IPsec)
TUNNEL_MSS="1360"
# Имя WAN-интерфейса. auto = определить по default route.
WAN_IF="auto"
