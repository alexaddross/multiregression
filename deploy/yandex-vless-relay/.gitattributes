# Скрипты и конфиги ДОЛЖНЫ иметь LF-окончания (иначе шебанг ломается: 'bash\r').
# Форсируем независимо от core.autocrlf на клиенте.
* text=auto eol=lf
*.sh        text eol=lf
*.json      text eol=lf
*.conf      text eol=lf
*.nft       text eol=lf
*.service   text eol=lf
*.md        text eol=lf
*.pem       binary
*.gpg       binary
*.tgz       binary
